# ── Required ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
TINYSIEM_API_KEY=change-this-to-a-long-random-string

# Generate: openssl rand -hex 32
TINYSIEM_JWT_SECRET=replace-with-64-char-random-string

# ── Authentication ─────────────────────────────────────────────────────────────
# Initial superadmin password (only used when users table is empty — change after first login)
TINYSIEM_SUPERADMIN_PASSWORD=admin
TINYSIEM_JWT_EXPIRY_HOURS=24

# ── Application ────────────────────────────────────────────────────────────────
TINYSIEM_DEBUG=false

# ── Storage ────────────────────────────────────────────────────────────────────
TINYSIEM_DUCKDB_PATH=/app/data/tinysiem.duckdb
TINYSIEM_ALERTS_PATH=/app/data/alerts/alerts.log
TINYSIEM_ALERT_MAX_MB=50

# ── Retention ──────────────────────────────────────────────────────────────────
TINYSIEM_RETENTION_DAYS=90
TINYSIEM_ARCHIVE_PATH=/app/data/archive

# ── Ingest listeners ───────────────────────────────────────────────────────────
TINYSIEM_SYSLOG_UDP_PORT=5140
TINYSIEM_SYSLOG_TCP_PORT=5141
TINYSIEM_BEATS_ENABLED=true

# ── Syslog guardrails ──────────────────────────────────────────────────────────
TINYSIEM_SYSLOG_ALLOW_CIDRS=
TINYSIEM_SYSLOG_MAX_BYTES=8192

# ── CORS (leave empty for same-origin only) ────────────────────────────────────
TINYSIEM_CORS_ORIGINS=

# ── Notifications (leave empty to disable) ─────────────────────────────────────
TINYSIEM_SMTP_HOST=
TINYSIEM_SMTP_PORT=587
TINYSIEM_SMTP_FROM=
TINYSIEM_SMTP_TO=
TINYSIEM_SMTP_TLS=true
TINYSIEM_SMTP_USER=
TINYSIEM_SMTP_PASS=
TINYSIEM_WEBHOOK_URL=
TINYSIEM_NOTIFY_MIN_SEV=high

# ── Reports ────────────────────────────────────────────────────────────────────
TINYSIEM_REPORT_SCHEDULE=disabled

# ── API Integrations (required for AWS CloudTrail / Google Workspace polling) ──
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TINYSIEM_MASTER_KEY=

# ── AI features ────────────────────────────────────────────────────────────────
# Configure via Settings → AI Config in the UI after logging in (admin role required) —
# no environment variable needed.

# ── MCP Server (Claude Desktop integration) ───────────────────────────────────
TINYSIEM_MCP_ENABLED=false

# ── TLS (leave empty to serve plain HTTP) ───────────────────────────────────────
TINYSIEM_TLS_CERT=
TINYSIEM_TLS_KEY=
